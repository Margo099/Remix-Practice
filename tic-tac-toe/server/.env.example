# Пример env для сервера
# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Admin secret for direct API access
API_SECRET=some-admin-secret

# Token time-to-live in milliseconds (default 5 minutes)
TOKEN_TTL_MS=300000

# Server port
PORT=3000

# Облачный Redis (Upstash)
REDIS_URL=rediss://default:YOUR_PASSWORD@us1-example.upstash.io:6379