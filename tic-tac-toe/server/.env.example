# Пример env для сервера
# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Опционально (TODO: можно добавить позже)
API_SECRET=some-admin-secret

# Жизнь токена в милисек (5 мин)
TOKEN_TTL_MS=300000

# Порт
PORT=3000

# Облачный Redis (Upstash)
REDIS_URL=rediss://default:YOUR_PASSWORD@us1-example.upstash.io:6379